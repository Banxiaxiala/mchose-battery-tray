# ── Python 缓存（tools/ 下的辅助脚本）──
__pycache__/
*.py[cod]
.venv/
venv/

# ── .NET 构建产物：绝不提交二进制 ──
[Bb]in/
[Oo]bj/
dist/
release/
*.user
*.suo
.vs/

# ── 旧版 PyInstaller 产物 ──
build/
*.spec
*.pdb

# ── 便携模式的运行时数据（exe 旁边的 data/：设置、历史、日志）──
# 这些是用户数据，绝不能提交；但文件夹本身由程序自动创建，无需 .gitkeep
/data/
/dist/data/

# ── 测试 / 打包产物 ──
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.json
*.nupkg
artifacts/

# ── 本地临时图片（README 用的素材在 assets/ 里）──
/*.png
/*.jpg

# ── 编辑器 ──
.vscode/
.idea/
*.swp

# ── 系统 ──
Thumbs.db
desktop.ini
